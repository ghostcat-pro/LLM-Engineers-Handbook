# Local-first profile. Use with: ENV_FILE=.env.local poetry poe local-check-hardware

USE_CLOUD=false
USE_LOCAL_MODELS=true
USE_ZENML_SECRET_STORE=false

# Local LLM runtime
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_CHAT_MODEL=qwen2.5:7b-instruct
LOCAL_MODEL_PATH=
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_LLM_MAX_RETRIES=2

# Local observability and artifact behavior
USE_OPIK=false
USE_HUGGINGFACE_HUB=false
USE_MLFLOW=true
MLFLOW_TRACKING_URI=file:data/mlruns
MLFLOW_EXPERIMENT_NAME=local-llm-twin

# MongoDB database
DATABASE_HOST=mongodb://llm_engineering:llm_engineering@127.0.0.1:27017
DATABASE_NAME=twin

# Qdrant vector database
USE_QDRANT_CLOUD=false
QDRANT_DATABASE_HOST=localhost
QDRANT_DATABASE_PORT=6333
QDRANT_CLOUD_URL=
QDRANT_APIKEY=

# Local RAG behavior
TEXT_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
RERANKING_CROSS_ENCODER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-4-v2
RAG_MODEL_DEVICE=cuda
RAG_USE_QUERY_EXPANSION=false
RAG_USE_SELF_QUERY=false
RAG_USE_RERANKING=true

# Conservative local training profile for RTX 3060 12GB
LOCAL_TRAINING_BASE_MODEL=models/mistral-7b
LOCAL_TRAINING_OUTPUT_DIR=data/training/runs/mistral-7b-local-qlora
LOCAL_TRAINING_DATA_DIR=data/training/datasets
LOCAL_TRAINING_MAX_SEQ_LENGTH=1024
LOCAL_TRAINING_LOAD_IN_4BIT=true
LOCAL_TRAINING_LORA_RANK=8
LOCAL_TRAINING_LORA_ALPHA=16
LOCAL_TRAINING_LORA_DROPOUT=0.05
LOCAL_TRAINING_BATCH_SIZE=1
LOCAL_TRAINING_GRADIENT_ACCUMULATION_STEPS=16
LOCAL_TRAINING_LEARNING_RATE=2e-4
LOCAL_TRAINING_NUM_EPOCHS=1

# Cloud credentials intentionally empty in local mode
OPENAI_API_KEY=
HUGGINGFACE_ACCESS_TOKEN=
COMET_API_KEY=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_ARN_ROLE=
